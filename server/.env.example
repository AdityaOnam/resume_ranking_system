SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct-Postgres password. Needed ONLY to run the standalone maintenance
# scripts in server/ (check_schema.py, alter_jobs.py, scratch_migration.py),
# which connect via psycopg2. The API never uses it - do NOT set this on
# Cloud Run, and never anywhere in the frontend/Vercel.
SUPABASE_DB_PASSWORD=
# Optional: override the derived db.<project-ref>.supabase.co host.
SUPABASE_DB_HOST=

# --- GitHub enrichment ---
# Optional, but strongly recommended. Unauthenticated GitHub API requests are
# capped at 60/hour, which a single resume with many repos can exhaust on its
# own. Any Personal Access Token raises this to 5000/hour - and reading public
# repos requires NO scopes at all, so generate the token with every scope
# unticked. This is a backend secret: set it in this file locally and as a
# Cloud Run env var / Secret Manager secret in production. Never in Vercel.
GITHUB_TOKEN=

# --- LLM provider configuration ---
# Set LLM_PROVIDER to choose between Groq, Google Gemini, or a local Ollama server.
#   "groq"    → Groq API (DEFAULT - fast, generous free tier, needs GROQ_API_KEYS)
#   "gemini"  → Google Gemini API (needs GEMINI_API_KEYS below)
#   "ollama"  → local Ollama server (no API key, but requires a reachable host -
#               do NOT use this in a cloud deployment, there is no local LLM there)
LLM_PROVIDER=groq

# Ollama settings (used when LLM_PROVIDER=ollama)
# Point OLLAMA_HOST at a remote/containerized Ollama instance if it isn't
# running on the same machine as the API.
OLLAMA_MODEL_NAME=llama3.2:1b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=150

# Gemini settings (used when LLM_PROVIDER=gemini)
# Provide one or more API keys separated by commas. If the first key hits a
# rate limit, the service automatically rotates to the next key.
GEMINI_API_KEYS=
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Groq settings (used when LLM_PROVIDER=groq)
# Get a key at https://console.groq.com/keys . Provide one or more separated by
# commas - if one hits its rate limit the service rotates to the next, which
# matters because Groq's free tier caps requests per minute AND per day.
GROQ_API_KEYS=
# GROQ_API_KEY (singular) still works, for backwards compatibility.

# IMPORTANT: Groq decommissions older models. A retired id returns 404, which is
# caught and turned into a fallback string - so AI feedback silently stops
# working with no visible error. The whole llama-3.x chat family has already
# been retired this way. List what YOUR key can actually reach with:
#   curl -H "Authorization: Bearer $GROQ_API_KEYS" https://api.groq.com/openai/v1/models
# Verified working (both plain text and JSON mode), ~0.6-0.8s each:
#   openai/gpt-oss-120b  better quality, same speed in practice (recommended)
#   openai/gpt-oss-20b   smaller/cheaper
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60

# --- ML model configuration ---
# Override any of these per machine/deployment without touching code.
# Leave unset to use the defaults baked into app/core/config.py.

# HuggingFace model ids for the embedding (bi-encoder) and cross-encoder models.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Shared on-disk cache for downloaded HF models. First run on a new machine
# downloads into this folder (needs internet access once); subsequent runs,
# or a deployment where this folder is pre-seeded/mounted as a volume, load
# straight from disk with no network call.
MODEL_CACHE_DIR=./assets/models/cache

# Ranking pipeline: only the top-K most similar eligible companies (by cheap
# bi-encoder similarity) get the expensive CrossEncoder pass per upload.
RANKING_CROSS_ENCODER_TOP_K=30

# development | production. In production, FRONTEND_ORIGINS is required (see app/main.py).
ENVIRONMENT=development
# FRONTEND_ORIGINS=https://app.example.com,https://www.example.com
